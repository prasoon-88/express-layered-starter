# General
SERVICE_NAME=express-layered-starter    # defaults to the package name, then "app"
PORT=8000                               # 1-65535
NODE_ENV=development                    # REQUIRED: development | test | production. "development" also sends stack traces in error responses
TRUST_PROXY=                            # hops behind a proxy (1, 2), true/false, or loopback/linklocal/uniquelocal/IP/CIDR, comma-separated. Empty = false

# Logging
LOG_LEVEL=info                          # fatal | error | warn | info | debug | trace | silent
LOG_PRETTY=true                         # true/false (also 1/0, yes/no, on/off). Human-readable output; JSON when false
LOG_IGNORE_PATHS=/health,/favicon.ico   # comma-separated, each starting with "/"; excluded from access logs
LOG_SLOW_MS=1000                        # requests at or above this many ms are logged as warnings

# Shutdown
SHUTDOWN_TIMEOUT_MS=8000                # total budget (ms) before a stuck shutdown is force-killed. Must be > SHUTDOWN_DELAY_MS
SHUTDOWN_DELAY_MS=5000                  # ms to keep serving after SIGTERM/SIGINT so load balancers can drain us (0 = none)

# Auth — access tokens (JWT, HS256) plus rotating refresh tokens
JWT_SECRET=                             # REQUIRED in production, at least 32 characters. Empty elsewhere = random per process, so tokens die on restart. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_TTL_S=900                    # access token lifetime (s). Cannot be revoked, so keep it short
JWT_REFRESH_TTL_S=2592000               # refresh token lifetime (s), 30 days. Each refresh issues a new one. Must be > JWT_ACCESS_TTL_S

# CORS — only needed when a browser app on another origin calls this API
CORS_ENABLED=false                      # true/false. When true, CORS_ORIGINS is required
CORS_ORIGINS=                           # comma-separated: https://app.example.com, http://localhost:5173, https://*.example.com (subdomains only). No path or trailing "/". "*" = any origin: never in production or with credentials
CORS_CREDENTIALS=false                  # true = browser may send cookies / Authorization. Cannot be combined with CORS_ORIGINS=*
CORS_METHODS=                           # empty = GET,POST,PUT,PATCH,DELETE,OPTIONS. Any of GET, HEAD, POST, PUT, PATCH, DELETE, OPTIONS
CORS_ALLOWED_HEADERS=                   # empty = Content-Type,Authorization,Idempotency-Key. Request headers the browser may send
CORS_EXPOSED_HEADERS=X-Request-Id,Idempotent-Replayed       # response headers page JS may read. Keep X-Request-Id so the frontend can report it
CORS_MAX_AGE_S=600                      # seconds a browser caches a preflight. Browsers cap it (Chrome: 7200)

# HTTP server timeouts. 0 disables a timer in Node. The schema rejects combinations that cause
# dropped connections, so a change here that boots is a change that is safe.
LB_IDLE_TIMEOUT_MS=60000                # idle timeout of the load balancer in front of us (ALB default 60s). Keep-alive must exceed it
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000        # must be > LB_IDLE_TIMEOUT_MS, so we never close a connection the balancer still reuses
HTTP_HEADERS_TIMEOUT_MS=67000           # must be > HTTP_KEEP_ALIVE_TIMEOUT_MS + 1000
HTTP_REQUEST_TIMEOUT_MS=120000          # must be >= HTTP_HEADERS_TIMEOUT_MS
REQUEST_HANDLER_TIMEOUT_MS=30000        # a request still running after this gets a 408. Must be < LB_IDLE_TIMEOUT_MS, or the balancer answers 504 first

# Rate limiting
RATE_LIMIT_ENABLED=true                 # true/false
RATE_LIMIT_STORE=memory                 # memory = per instance. redis = shared across replicas (needs REDIS_URL)
RATE_LIMIT_ON_STORE_ERROR=local         # when Redis is down: local = fall back to per-instance memory | allow = let requests through | deny = answer 503
RATE_LIMIT_MAX=100                      # global policy: requests per window, per client
RATE_LIMIT_WINDOW_S=60                  # global policy: window length in seconds
RATE_LIMIT_AUTH_MAX=10                  # auth policy (credential endpoints such as register): attempts per window
RATE_LIMIT_AUTH_WINDOW_S=900            # auth policy: window length in seconds
RATE_LIMIT_AUTH_BLOCK_S=900             # auth policy: how long a client stays blocked once it exceeds the limit (0 = no extra block; limited only until the window resets)
RATE_LIMIT_IPV6_SUBNET=56               # IPv6 clients are limited per /N subnet, 32-128. A single device can use a whole /64
RATE_LIMIT_POLICY_REFRESH_S=30          # how often (s) policy overrides are re-read from Redis. 0 = never. Redis store only
RATE_LIMIT_SKIP_PATHS=                  # comma-separated paths never limited, each starting with "/". /health is already outside the limiter

# Idempotency — replays a completed POST/PATCH when the client retries the same Idempotency-Key
IDEMPOTENCY_ENABLED=true                # true/false
IDEMPOTENCY_STORE=memory                # memory = per instance. redis = shared across replicas (needs REDIS_URL)
IDEMPOTENCY_ON_STORE_ERROR=deny         # when the store is down: allow = run the handler anyway | deny = answer 503
IDEMPOTENCY_TTL_S=86400                 # how long a completed response can be replayed
IDEMPOTENCY_LOCK_TTL_S=60               # how long an in-progress key is held. Must be greater than REQUEST_HANDLER_TIMEOUT_MS
IDEMPOTENCY_MAX_BODY_BYTES=262144       # responses larger than this are not stored, so a retry runs the handler again

# Redis (only when RATE_LIMIT_STORE=redis or IDEMPOTENCY_STORE=redis). The client speaks RESP2, so Redis older than 6 works too (tested on 5.0)
REDIS_URL=                              # redis://[:password@]host:6379 or rediss:// for TLS
REDIS_CONNECT_TIMEOUT_MS=5000           # startup waits this long for Redis, then continues and keeps reconnecting in the background
