{
  "name": "express-layered-starter",
  "version": "1.0.0",
  "main": "dist/server.js",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "dev": "node --conditions=app-source --env-file=.env --watch --import ./src/instrumentation.ts src/server.ts",
    "start": "node --enable-source-maps --import ./dist/instrumentation.js dist/server.js",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node scripts/copy-views.js",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --conditions=app-source --test \"src/**/*.test.ts\"",
    "test:coverage": "node --conditions=app-source --test --experimental-test-coverage --test-coverage-include-all --test-coverage-include=\"src/**/*.ts\" --test-coverage-exclude=\"src/**/*.test.ts\" --test-coverage-exclude=\"src/**/*.d.ts\" --test-coverage-exclude=\"src/testing/**\" --test-coverage-lines=95 --test-coverage-branches=88 --test-coverage-functions=88 \"src/**/*.test.ts\"",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test:coverage && pnpm run build"
  },
  "author": "Prasoon Asati",
  "license": "ISC",
  "description": "",
  "imports": {
    "#config/*": {
      "app-source": "./src/config/*.ts",
      "default": "./dist/config/*.js"
    },
    "#constants/*": {
      "app-source": "./src/constants/*.ts",
      "default": "./dist/constants/*.js"
    },
    "#contexts/*": {
      "app-source": "./src/contexts/*.ts",
      "default": "./dist/contexts/*.js"
    },
    "#controllers/*": {
      "app-source": "./src/controllers/*.ts",
      "default": "./dist/controllers/*.js"
    },
    "#errors": {
      "app-source": "./src/errors/index.ts",
      "default": "./dist/errors/index.js"
    },
    "#errors/*": {
      "app-source": "./src/errors/*.ts",
      "default": "./dist/errors/*.js"
    },
    "#http/*": {
      "app-source": "./src/http/*.ts",
      "default": "./dist/http/*.js"
    },
    "#lib/*": {
      "app-source": "./src/lib/*.ts",
      "default": "./dist/lib/*.js"
    },
    "#middlewares/*": {
      "app-source": "./src/middlewares/*.ts",
      "default": "./dist/middlewares/*.js"
    },
    "#models/*": {
      "app-source": "./src/models/*.ts",
      "default": "./dist/models/*.js"
    },
    "#modules/*": {
      "app-source": "./src/modules/*.ts",
      "default": "./dist/modules/*.js"
    },
    "#rateLimiter": {
      "app-source": "./src/rateLimiter/index.ts",
      "default": "./dist/rateLimiter/index.js"
    },
    "#idempotency": {
      "app-source": "./src/idempotency/index.ts",
      "default": "./dist/idempotency/index.js"
    },
    "#repository/*": {
      "app-source": "./src/repository/*.ts",
      "default": "./dist/repository/*.js"
    },
    "#routes/*": {
      "app-source": "./src/routes/*.ts",
      "default": "./dist/routes/*.js"
    },
    "#schemas/*": {
      "app-source": "./src/schemas/*.ts",
      "default": "./dist/schemas/*.js"
    },
    "#services/*": {
      "app-source": "./src/services/*.ts",
      "default": "./dist/services/*.js"
    },
    "#utils/*": {
      "app-source": "./src/utils/*.ts",
      "default": "./dist/utils/*.js"
    },
    "#testing/*": {
      "app-source": "./src/testing/*.ts"
    }
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.0",
    "@opentelemetry/instrumentation-pino": "^0.71.0",
    "@opentelemetry/instrumentation-redis": "^0.73.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.38.0",
    "@opentelemetry/sdk-node": "^0.301.0",
    "cors": "^2.8.6",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "import-in-the-middle": "^3.5.3",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.4.0",
    "rate-limiter-flexible": "^11.2.4",
    "redis": "^6.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
