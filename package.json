{
  "name": "express-layered-starter",
  "version": "1.0.0",
  "main": "src/server.js",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint \"src/**/*.js\" eslint.config.js",
    "lint:fix": "eslint \"src/**/*.js\" eslint.config.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "Prasoon Asati",
  "license": "ISC",
  "description": "",
  "imports": {
    "#config/*": "./src/config/*",
    "#constants/*": "./src/constants/*",
    "#contexts/*": "./src/contexts/*",
    "#controllers/*": "./src/controllers/*",
    "#errors": "./src/errors/index.js",
    "#errors/*": "./src/errors/*",
    "#lib/*": "./src/lib/*",
    "#middlewares/*": "./src/middlewares/*",
    "#models/*": "./src/models/*",
    "#repository/*": "./src/repository/*",
    "#routes/*": "./src/routes/*",
    "#services/*": "./src/services/*",
    "#utils/*": "./src/utils/*"
  },
  "dependencies": {
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10"
  }
}
