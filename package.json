{
  "name": "express-layered-starter",
  "version": "1.0.0",
  "main": "dist/server.js",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "dev": "node --conditions=app-source --env-file=.env --watch src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run build"
  },
  "author": "Prasoon Asati",
  "license": "ISC",
  "description": "",
  "imports": {
    "#config/*": {
      "app-source": "./src/config/*.ts",
      "default": "./dist/config/*.js"
    },
    "#constants/*": {
      "app-source": "./src/constants/*.ts",
      "default": "./dist/constants/*.js"
    },
    "#contexts/*": {
      "app-source": "./src/contexts/*.ts",
      "default": "./dist/contexts/*.js"
    },
    "#controllers/*": {
      "app-source": "./src/controllers/*.ts",
      "default": "./dist/controllers/*.js"
    },
    "#errors": {
      "app-source": "./src/errors/index.ts",
      "default": "./dist/errors/index.js"
    },
    "#errors/*": {
      "app-source": "./src/errors/*.ts",
      "default": "./dist/errors/*.js"
    },
    "#lib/*": {
      "app-source": "./src/lib/*.ts",
      "default": "./dist/lib/*.js"
    },
    "#middlewares/*": {
      "app-source": "./src/middlewares/*.ts",
      "default": "./dist/middlewares/*.js"
    },
    "#models/*": {
      "app-source": "./src/models/*.ts",
      "default": "./dist/models/*.js"
    },
    "#repository/*": {
      "app-source": "./src/repository/*.ts",
      "default": "./dist/repository/*.js"
    },
    "#routes/*": {
      "app-source": "./src/routes/*.ts",
      "default": "./dist/routes/*.js"
    },
    "#services/*": {
      "app-source": "./src/services/*.ts",
      "default": "./dist/services/*.js"
    },
    "#utils/*": {
      "app-source": "./src/utils/*.ts",
      "default": "./dist/utils/*.js"
    }
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
